{
  "name": "dsh-workspace-batch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Batch-remove sidebar Workspaces in DeepSeek Harness. Removes the registration only — folders and session logs are kept.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theTd/dsh-workspace-batch.git"
  },
  "homepage": "https://github.com/theTd/dsh-workspace-batch#readme",
  "bugs": {
    "url": "https://github.com/theTd/dsh-workspace-batch/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT"
}
